+// Hardware-accelerated keccak-f[1600] for zkVM targets
+#if defined(SP1_TARGET)
+// SP1 KECCAK_PERMUTE syscall (code 0x00010109)
+static void sp1_keccak_permute(uint64_t state[25])
+{
+    register unsigned int t0 __asm__("t0") = 0x00010109;
+    register void* a0 __asm__("a0") = (void*)state;
+    register void* a1 __asm__("a1") = (void*)0;
+    __asm__ volatile("ecall" : "+r"(t0) : "r"(a0), "r"(a1) : "memory");
+}
+
+static void (*keccakf1600_best)(uint64_t[25]) = sp1_keccak_permute;
+#elif defined(__riscv)
+// Zisk keccak syscall
+extern void syscall_keccak_f(uint64_t state[25]);
